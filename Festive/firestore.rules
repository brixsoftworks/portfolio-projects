rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Guest-friendly storefront: anyone may place an order, but only with a
    // validated, non-privileged payload. Orders can NEVER be created as paid.
    match /orders/{orderId} {
      allow create: if request.resource.data.keys().hasOnly(
            ["userId", "customer", "items", "subtotal", "shipping", "total", "status", "paymentStatus", "createdAt"])
        && request.resource.data.status == "placed"
        && request.resource.data.paymentStatus == "unpaid"
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.customer.name is string
        && request.resource.data.customer.name.size() > 0;

      // Order history requires sign-in and ownership. Guests cannot read back.
      allow read: if request.auth != null
        && resource.data.userId == request.auth.uid;

      // No client updates or deletes — payment/order lifecycle is server work.
      allow update, delete: if false;
    }
  }
}
