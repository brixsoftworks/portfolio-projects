<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sadhguru Gurukulam Samskriti - Audio Request Bridge</title>
    <link rel="icon" type="image/png" href="icon.png">
    <link rel="stylesheet" href="style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&family=Roboto:wght@300;400;500&family=Playfair+Display:wght@400;700;900&family=Montserrat:wght@300;400;600;800&family=Raleway:wght@300;400;600;700&family=Merriweather:wght@300;400;700&family=Dancing+Script:wght@400;700&family=Bebas+Neue&family=Oswald:wght@300;400;600;700&family=Source+Sans+Pro:wght@300;400;600;700&family=Open+Sans:wght@300;400;600;700&family=Lato:wght@300;400;700;900&family=Abril+Fatface&family=Comfortaa:wght@300;400;700&family=Daniel:wght@400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
</head>
<body>
    <!-- Loading Overlay -->
    <div class="loading-overlay" id="loadingOverlay">
        <div class="loading-spinner"></div>
    </div>

    <!-- Progress Bar -->
    <div class="progress-bar" id="progressBar" style="width: 0%;"></div>

    <!-- Particle Background -->
    <div class="particles" id="particles"></div>

    <!-- Toast Container -->
    <div class="toast-container" id="toastContainer"></div>

    <!-- Navigation -->
    <nav class="navbar">
        <div class="container" style="display: flex; justify-content: space-between; align-items: center;">
<div class="nav-brand">
                <div class="logo" id="logoContainer">
                    <img id="siteLogo"
                         src="Isha sadhgurukulam logo.png"
                         alt="Isha Sadhguru Gurukulam Logo"
                         class="site-logo"
                         onerror="this.style.display='none'; document.getElementById('logoFallback').style.display='flex'">

                    <!-- fallback: original mic icon shown when image fails to load -->
                    <div id="logoFallback" class="mic-icon" style="display:none; align-items:center; justify-content:center;">
                        <div class="mic-body"></div>
                        <div class="mic-head"></div>
                        <div class="mic-stand"></div>
                    </div>
                </div>
                 <h1>Audio Request Bridge</h1>
             </div>
<div class="nav-menu">
                <a href="#" onclick="showHomeSection()" class="active" data-tooltip="Home">
                    <i class="fas fa-home"></i> Home
                </a>
                <a href="#" onclick="showTrackSection()" data-tooltip="Track your requests">
                    <i class="fas fa-search"></i> Track Request
                </a>
                <a href="admin.html" class="admin-link" data-tooltip="Admin panel">
                    <i class="fas fa-cog"></i> Admin
                </a>

            </div>
            <div class="mobile-menu-btn" onclick="toggleMobileMenu()">
                <i class="fas fa-bars"></i>
            </div>
        </div>
    </nav>

<!-- Hero Section -->
    <section class="hero">
        <div class="container">
            <div class="hero-content reveal">

                <h1 class="hero-title">
                    <span class="gradient-text">Audio Request</span><br>
                    Bridge
                </h1>
                <p class="hero-description">
                    Streamline your event audio requests with our seamless coordination platform. Connect instantly with the Audio Team and schedule your setup for assemblies, cultural programs, and special events with ease.
                </p>
                
                <div class="feature-highlights">
                    <div class="feature-item">
                        <i class="fas fa-bolt"></i>
                        <span>Quick Setup</span>
                    </div>
                    <div class="feature-item">
                        <i class="fas fa-users"></i>
                        <span>Team Coordination</span>
                    </div>
                    <div class="feature-item">
                        <i class="fas fa-clock"></i>
                        <span>Real-time Tracking</span>
                    </div>
                </div>
                
                <div class="action-buttons">
                    <button class="btn btn-primary" onclick="scrollToEventTypes()">
                        <i class="fas fa-plus-circle"></i> Raise a Request
                    </button>
                    <button class="btn btn-secondary" onclick="showTrackSection()">
                        <i class="fas fa-search"></i> Track My Request
                    </button>
                    <button class="btn btn-outline" onclick="showQuickTour()">
                        <i class="fas fa-play-circle"></i> Quick Tour
                    </button>
                </div>
            </div>

        </div>
    </section>

    <!-- Main Content -->
    <div class="container">
        <!-- Event Types Section -->
        <section class="event-types" id="eventTypes">
            <h3>Select Event Type</h3>
            <p class="section-subtitle">Choose the appropriate audio setup for your event</p>
            
            <div class="event-cards">
                <div class="event-card" onclick="openRequestForm('av')">
                    <i class="fas fa-microphone"></i>
                    <h4>AV Setup</h4>
                    <p>Audio and video setup (1-3 mics)</p>
                    <p><small>10 min setup + 5 min soundcheck</small></p>
                    <p><small style="color: var(--warning);">⚠️ Request 1 day in advance</small></p>
                </div>
                
                <div class="event-card" onclick="openRequestForm('dwani')">
                    <i class="fas fa-volume-up"></i>
                    <h4>Dwani Setup</h4>
                    <p>Default setup for Dwani (up to 7 mics)</p>
                    <p><small>30 min setup + 15 min soundcheck</small></p>
                    <p><small style="color: var(--warning);">⚠️ Request 3 days in advance</small></p>
                </div>
                
                <div class="event-card" onclick="openRequestForm('small')">
                    <i class="fas fa-users"></i>
                    <h4>Small Events & Rehearsals</h4>
                    <p>For small events (up to 6 mics)</p>
                    <p><small>20 min setup + 10 min soundcheck</small></p>
                    <p><small style="color: var(--warning);">⚠️ Request 3 days in advance</small></p>
                </div>
                
                <div class="event-card" onclick="openRequestForm('large')">
                    <i class="fas fa-star"></i>
                    <h4>Large Events</h4>
                    <p>Large scale events (up to 16 mics)</p>
                    <p><small>45-60 min setup + 30 min soundcheck</small></p>
                    <p><small style="color: var(--warning);">⚠️ Request 3 days in advance</small></p>
                </div>
            </div>
        </section>

        <!-- Track Request Section (Hidden by default) -->
        <section class="track-section" id="trackSection" style="display: none; padding: 80px 0;">
            <h3 style="text-align: center; color: var(--primary-color); font-family: 'Playfair Display', serif; font-weight: 700; font-size: 2.2rem;">Track My Request</h3>
            <div style="text-align: center; margin-bottom: 20px;">
                <button class="btn btn-outline" onclick="showHomeSection()">
                    <i class="fas fa-arrow-left"></i> Back to Home
                </button>
            </div>
            <div style="max-width: 600px; margin: 30px auto; background: var(--bg-primary); color: var(--text-color); padding: 30px; border-radius: 10px; box-shadow: var(--shadow); border: 1px solid var(--border-color);">
                <div class="form-group">
                    <label>Enter Your Email</label>
                    <input type="email" id="trackEmail" class="form-control" placeholder="your.email@school.edu">
                </div>
                <button class="btn btn-primary" onclick="trackRequests()" style="width: 100%;">
                    <i class="fas fa-search"></i> Track Requests
                </button>
                
                <div id="requestsList" style="margin-top: 30px;"></div>
            </div>
        </section>
    </div>

    <!-- Request Form Modal -->
    <div class="modal" id="requestModal">
        <div class="modal-content">
            <div class="modal-header">
                <h3 id="modalTitle">New Request</h3>
                <button class="modal-close" onclick="closeModal()">&times;</button>
            </div>
            <div class="modal-body">
                <div id="formContent">
                    <!-- Dynamic form content will be inserted here -->
                </div>
            </div>
        </div>
    </div>

    <!-- Success Modal -->
    <div class="modal" id="successModal">
        <div class="modal-content" style="text-align: center; padding: 40px;">
            <i class="fas fa-check-circle" style="font-size: 5rem; color: #4CAF50; margin-bottom: 20px;"></i>
            <h3 style="color: var(--primary-color);">Request Submitted!</h3>
            <p>Your request has been submitted successfully.</p>
            <div id="requestIdDisplay" style="background: var(--bg-primary); padding: 15px; border-radius: 8px; margin: 20px 0; font-family: monospace; color: var(--text-color); border:1px solid var(--border-color)"></div>
            <button class="btn btn-primary" onclick="closeSuccessModal()">OK</button>
        </div>
    </div>

    <!-- Footer -->
    <footer class="footer">
        <div class="container">
            <div class="footer-content">
                <div class="footer-logo">
                    <div class="footer-logo-image" style="height: 60px; width: auto; max-width: 180px; display: flex; align-items: center; justify-content: center;">
                        <img src="Isha sadhgurukulam logo.png" alt=" Sadhguru Gurukulam Logo" style="height: 100%; width: auto; object-fit: contain; filter: drop-shadow(0 2px 8px rgba(0,168,232,0.3));">
                    </div>
                    <div>
                        <h4 style="color: white; margin-bottom: 5px; font-family: 'Bebas Neue', cursive; font-size: 1.5rem; text-transform: uppercase; letter-spacing: 1px;"> 
                        <p style="color: #ddd; font-family: 'Lato', sans-serif; font-style: italic; letter-spacing: 0.5px;">Audio Request Bridge</p>
                    </div>
                </div>
                <div class="footer-links">
                    <a href="mailto:schedule.samskriti@sadhguru.org">
                        <i class="fas fa-envelope"></i> schedule.samskriti@sadhguru.org
                    </a>
                    <p><i class="fas fa-phone"></i>  Audio Team Contact: Swami.Mullainathan</p>
                </div>
            </div>
            <div class="footer-bottom">
                <p>&copy; 2026 Audio Request Bridge. All rights reserved.</p>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://www.gstatic.com/firebasejs/9.22.0/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.22.0/firebase-firestore-compat.js"></script>
    <script>
        // Initialize Firebase
        const firebaseConfig = {
            apiKey: "AIzaSyYourApiKeyHere",
            authDomain: "samskriti-audio.firebaseapp.com",
            projectId: "samskriti-audio",
            storageBucket: "samskriti-audio.appspot.com",
            messagingSenderId: "123456789",
            appId: "1:123456789:web:abcdef123456"
        };
        
        firebase.initializeApp(firebaseConfig);
        const db = firebase.firestore();

        // Event Types Configuration
        const eventConfigs = {
            'av': {
                title: 'AV Setup Request',
                description: 'AV setup will contain: 1 to 3 microphones, Audio and video setup. Requires: 10 minutes setup time, 5 minutes soundcheck time, 5 minutes windup time.<br><br><strong>⚠️ Important:</strong> Requests must be raised at least 1 day in advance to avoid rejection due to scheduling issues.',
                maxMics: 3
            },
            'dwani': {
                title: 'Dwani Setup Request',
                description: 'Dwani setup includes: Up to 7 microphones, Audio file playback if required. Requires: 30 minutes setup time, 15 minutes soundcheck time, 20 minutes windup time.<br><br><strong>⚠️ Important:</strong> Requests must be raised at least 3 days in advance to avoid rejection due to scheduling issues.',
                maxMics: 7
            },
            'small': {
                title: 'Small Event / Rehearsal Request',
                description: 'For in-school small events and performance rehearsals: Up to 6 microphones. Requires: 20 minutes setup time, 10 minutes soundcheck, 10 minutes windup.<br><br><strong>⚠️ Important:</strong> Requests must be raised at least 3 days in advance to avoid rejection due to scheduling issues.',
                maxMics: 6
            },
            'large': {
                title: 'Large Event Request',
                description: 'Large events setup includes: Up to 16 microphones, 45 minutes to 1 hour of setup time, 30 minutes of soundcheck, 40 minutes windup time.<br><br><strong>⚠️ Important:</strong> Requests must be raised at least 3 days in advance to avoid rejection due to scheduling issues.<br><br><strong>⚠️ WARNING:</strong> You must arrange gate pass and vehicle access for large event equipment setup. <strong>The audio team will NOT arrange these for you.</strong>',
                maxMics: 16
            }
        };

        let currentEventType = '';

        // Mobile Menu
        function toggleMobileMenu() {
            document.querySelector('.nav-menu').classList.toggle('active');
        }

        // Scroll to event types
        function scrollToEventTypes() {
            document.getElementById('eventTypes').scrollIntoView({ behavior: 'smooth' });
        }

        // Show home section
        function showHomeSection() {
            document.getElementById('trackSection').style.display = 'none';
            document.getElementById('eventTypes').style.display = 'block';
            document.querySelector('.hero').style.display = 'block';
            window.scrollTo({ top: 0, behavior: 'smooth' });
            updateNavActive('home');
        }

        // Show track section
        function showTrackSection() {
            document.querySelector('.hero').style.display = 'none';
            document.getElementById('eventTypes').style.display = 'none';
            document.getElementById('trackSection').style.display = 'block';
            window.scrollTo({ top: 0, behavior: 'smooth' });
            updateNavActive('track');
        }

        // Back to events (deprecated - use showHomeSection instead)
        function backToEvents() {
            showHomeSection();
        }

        // Update navigation active states
        function updateNavActive(section) {
            const navLinks = document.querySelectorAll('.nav-menu a');
            navLinks.forEach(link => {
                link.classList.remove('active');
                if (section === 'home' && link.innerHTML.includes('Home')) {
                    link.classList.add('active');
                } else if (section === 'track' && link.innerHTML.includes('Track')) {
                    link.classList.add('active');
                }
            });
        }

        // Open request form
        function openRequestForm(eventType) {
            currentEventType = eventType;
            const config = eventConfigs[eventType];
            
            document.getElementById('modalTitle').textContent = config.title;
            
            let formHTML = `
                <div style="margin-bottom: 20px; background: var(--bg-primary); color: var(--text-color); border:1px solid var(--border-color); padding: 15px; border-radius: 5px;">
                    <p style="margin: 0; font-size: 0.95rem; color: var(--text-color);">${config.description}</p>
                </div>
                
                <div class="form-group">
                    <label>Number of Microphones</label>
                    <div class="mic-selection" id="micSelection">
                        ${Array.from({length: config.maxMics}, (_, i) => i + 1)
                            .map(num => `<button type="button" class="mic-btn" onclick="selectMic(this, ${num})">${num} ${num === 1 ? 'Mic' : 'Mics'}</button>`)
                            .join('')}
                    </div>
                    <input type="hidden" id="numMics" required>
                </div>
                
                ${eventType === 'dwani' ? `
                <div class="form-group">
                    <label>Additional Requirements</label>
                    <div class="setup-options">
                        <button type="button" class="option-btn" onclick="toggleOption(this)">Audio + Video</button>
                    </div>
                </div>
                ` : ''}
                
                ${eventType === 'large' ? `
                <div class="form-group">
                    <label>Additional Requirements</label>
                    <div class="setup-options">
                        <button type="button" class="option-btn" onclick="toggleOption(this)">Audio + Video Setup</button>
                    </div>
                </div>
                ` : ''}
                
                <div class="form-group">
                    <label>Your Name</label>
                    <input type="text" id="requestName" class="form-control" required>
                </div>
                
                <div class="form-group">
                    <label>Email Address</label>
                    <input type="email" id="requestEmail" class="form-control" required>
                </div>
                
                <div class="form-group">
                    <label>Event Date</label>
                    <input type="date" id="requestDate" class="form-control" required min="${new Date().toISOString().split('T')[0]}">
                </div>
                
                <div class="form-group">
                    <label>Event Time</label>
                    <input type="time" id="requestTime" class="form-control" required>
                </div>
                
                <div class="form-group">
                    <label>Event Duration</label>
                    <div style="display: flex; gap: 10px;">
                        <div style="flex: 1;">
                            <input type="number" id="durationHours" class="form-control" placeholder="Hours" min="0" max="12" value="0">
                        </div>
                        <div style="flex: 1;">
                            <input type="number" id="durationMinutes" class="form-control" placeholder="Minutes" min="0" max="59" value="30">
                        </div>
                    </div>
                </div>
                
                <div class="form-group">
                    <label>Event Venue</label>
                    <input type="text" id="requestVenue" class="form-control" placeholder="e.g., Samskriti Grounds" required>
                </div>
                
                <div class="form-group">
                    <label>Additional Notes (Optional)</label>
                    <textarea id="requestNotes" class="form-control" rows="3" placeholder="Any special requirements, additional information, or comments..."></textarea>
                </div>
                
                <div class="modal-actions">
                    <button class="btn" onclick="closeModal()" style="background: #f8f9fa;">Cancel</button>
                    <button class="btn btn-primary" onclick="submitRequest()">Submit Request</button>
                </div>
            `;
            
            document.getElementById('formContent').innerHTML = formHTML;
            document.getElementById('requestModal').classList.add('active');
        }

        // Select microphone
        function selectMic(btn, num) {
            document.querySelectorAll('.mic-btn').forEach(b => b.classList.remove('active'));
            if (btn && btn.classList) btn.classList.add('active');
            document.getElementById('numMics').value = num;
        }

        // Toggle option
        function toggleOption(btn) {
            btn.classList.toggle('active');
        }

        // Close modal
        function closeModal() {
            document.getElementById('requestModal').classList.remove('active');
        }

        // Close success modal
        function closeSuccessModal() {
            document.getElementById('successModal').classList.remove('active');
            location.reload();
        }

        // Submit request
        async function submitRequest() {
            const hours = parseInt(document.getElementById('durationHours').value) || 0;
            const minutes = parseInt(document.getElementById('durationMinutes').value) || 0;
            const totalDuration = hours + (minutes / 60);
            
            const formData = {
                eventType: currentEventType,
                name: document.getElementById('requestName').value,
                email: document.getElementById('requestEmail').value,
                eventDate: document.getElementById('requestDate').value,
                eventTime: document.getElementById('requestTime').value,
                eventDuration: totalDuration.toString(),
                venue: document.getElementById('requestVenue').value,
                numMics: document.getElementById('numMics').value,
                notes: document.getElementById('requestNotes').value
            };

            // Validation
            if (!formData.numMics || !formData.name || !formData.email || !formData.eventDate || !formData.eventTime || totalDuration <= 0 || !formData.venue) {
                alert('Please fill all required fields and ensure event duration is greater than 0');
                return;
            }

            try {
                showLoading();
                updateProgress(50);
                
                // Generate request ID and save to Firestore
                const timestamp = new Date().getTime();
                const requestId = `REQ${timestamp}`;
                
                const docData = {
                    requestId: requestId,
                    eventType: formData.eventType,
                    name: formData.name,
                    email: formData.email,
                    eventDate: formData.eventDate,
                    eventTime: formData.eventTime,
                    eventDuration: formData.eventDuration,
                    venue: formData.venue,
                    numMics: formData.numMics,
                    notes: formData.notes,
                    status: "Raised and Sent to Schedule Team",
                    createdAt: firebase.firestore.FieldValue.serverTimestamp()
                };
                
                await db.collection('audioRequests').add(docData);
                
                updateProgress(100);
                hideLoading();
                
                document.getElementById('requestIdDisplay').textContent = `Request ID: ${requestId}`;
                closeModal();
                document.getElementById('successModal').classList.add('active');
                showToast('Request submitted successfully!', 'success');
            } catch (error) {
                console.error('Error details:', error);
                hideLoading();
                alert(`Failed to submit request: ${error.message}. Please check your internet connection and try again.`);
            } finally {
                updateProgress(0);
            }
        }

        // Track requests
        async function trackRequests() {
            const emailInput = document.getElementById('trackEmail');
            if (!emailInput) return;
            
            const email = emailInput.value.trim().toLowerCase();
            
            if (!email) {
                alert('Please enter your email address');
                return;
            }

            try {
                showLoading();
                
                // Query Firestore for all requests (since we can't do case-insensitive email query)
                const snapshot = await db.collection('audioRequests')
                    .orderBy('eventDate', 'asc')
                    .orderBy('eventTime', 'asc')
                    .get();
                
                const requests = [];
                const now = new Date();
                
                snapshot.forEach(doc => {
                    const data = doc.data();
                    
                    // Case-insensitive email comparison
                    if (data.email && data.email.trim().toLowerCase() === email) {
                        // Parse event date and time
                        const eventDateTime = new Date(`${data.eventDate}T${data.eventTime}`);
                        
                        // Only show future events (eventDateTime > current time)
                        if (eventDateTime > now) {
                            requests.push({
                                requestId: data.requestId,
                                eventType: data.eventType,
                                eventDate: data.eventDate,
                                eventTime: data.eventTime,
                                numMics: data.numMics,
                                status: data.status
                            });
                        }
                    }
                });
                
                console.log('Track requests result:', requests);
                displayRequests(requests);
            } catch (error) {
                console.error('Error tracking requests:', error);
                showToast('Failed to track requests. Please try again.', 'error');
            } finally {
                hideLoading();
            }
        }

        // Display requests
        function displayRequests(requests) {
            const container = document.getElementById('requestsList');
            
            if (requests.length === 0) {
                container.innerHTML = '<p style="text-align: center; color: #666;">No active requests found.</p>';
                return;
            }

            let html = '<h4 style="color:var(--text-color)">Your Active Requests:</h4>';
            
            requests.forEach(req => {
                html += `
                    <div style="background: var(--bg-primary); border: 1px solid var(--border-color); border-radius: 8px; padding: 15px; margin: 10px 0; color: var(--text-color);">
                        <div style="display: flex; justify-content: space-between; align-items: center;">
                            <strong style="color:var(--primary-color)">${req.eventType}</strong>
                            <span style="background: ${req.status === 'Approved' ? 'rgba(16,185,129,0.12)' : 'rgba(245,158,11,0.12)'}; 
                                      color: ${req.status === 'Approved' ? 'var(--success)' : 'var(--warning)'}; 
                                      padding: 6px 12px; border-radius: 20px; font-size: 0.9rem;">
                                ${req.status}
                            </span>
                        </div>
                        <p style="margin: 8px 0 4px; font-size: 0.9rem;">ID: ${req.requestId}</p>
                        <p style="margin: 4px 0; font-size: 0.9rem;">Date: ${req.eventDate} at ${req.eventTime}</p>
                        <p style="margin: 4px 0; font-size: 0.9rem;">Mics: ${req.numMics}</p>
                    </div>
                `;
            });

            container.innerHTML = html;
        }

// Close modal on outside click
        document.addEventListener('click', function(e) {
            if (e.target.classList.contains('modal')) {
                closeModal();
                closeSuccessModal();
            }
        });

        // ========== ADVANCED FEATURES ==========



        // Toast Notification System
        function showToast(message, type = 'info', duration = 3000) {
            const toastContainer = document.getElementById('toastContainer');
            const toast = document.createElement('div');
            toast.className = `toast ${type}`;
            
            const icons = {
                success: 'fas fa-check-circle',
                error: 'fas fa-exclamation-circle',
                warning: 'fas fa-exclamation-triangle',
                info: 'fas fa-info-circle'
            };
            
            toast.innerHTML = `
                <i class="${icons[type]}"></i>
                <span>${message}</span>
                <button onclick="this.parentElement.remove()" style="background: none; border: none; color: inherit; cursor: pointer; margin-left: auto;">
                    <i class="fas fa-times"></i>
                </button>
            `;
            
            toastContainer.appendChild(toast);
            
            setTimeout(() => {
                toast.style.animation = 'slideInRight 0.3s ease reverse';
                setTimeout(() => toast.remove(), 300);
            }, duration);
        }

        // Loading Management
        function showLoading() {
            document.getElementById('loadingOverlay').classList.add('active');
        }

        function hideLoading() {
            document.getElementById('loadingOverlay').classList.remove('active');
        }

        // Progress Bar
        function updateProgress(percentage) {
            document.getElementById('progressBar').style.width = percentage + '%';
        }

        // Particle System
        function initParticles() {
            const particlesContainer = document.getElementById('particles');
            const particleCount = 30;
            
            for (let i = 0; i < particleCount; i++) {
                const particle = document.createElement('div');
                particle.className = 'particle';
                particle.style.left = Math.random() * 100 + '%';
                particle.style.animationDelay = Math.random() * 20 + 's';
                particle.style.animationDuration = (15 + Math.random() * 10) + 's';
                particlesContainer.appendChild(particle);
            }
        }

        // Scroll Reveal Animation
        function initScrollReveal() {
            const reveals = document.querySelectorAll('.reveal');
            
            function reveal() {
                reveals.forEach(element => {
                    const windowHeight = window.innerHeight;
                    const elementTop = element.getBoundingClientRect().top;
                    const elementVisible = 150;
                    
                    if (elementTop < windowHeight - elementVisible) {
                        element.classList.add('active');
                    }
                });
            }
            
            window.addEventListener('scroll', reveal);
            reveal(); // Initial check
        }



        // Form Validation
        function validateForm(formData) {
            const errors = [];
            
            if (!formData.name || formData.name.trim().length < 2) {
                errors.push('Name must be at least 2 characters long');
            }
            
            const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
            if (!formData.email || !emailRegex.test(formData.email)) {
                errors.push('Please enter a valid email address');
            }
            
            if (!formData.eventDate) {
                errors.push('Please select an event date');
            } else {
                const selectedDate = new Date(formData.eventDate);
                const today = new Date();
                today.setHours(0, 0, 0, 0);
                if (selectedDate < today) {
                    errors.push('Event date cannot be in the past');
                }
            }
            
            if (!formData.eventTime) {
                errors.push('Please select an event time');
            }
            
            if (!formData.numMics || formData.numMics < 1) {
                errors.push('Please select at least 1 microphone');
            }
            
            if (!formData.venue || formData.venue.trim().length < 2) {
                errors.push('Please enter a valid venue location');
            }
            
            return errors;
        }

        // Keyboard Shortcuts
        function initKeyboardShortcuts() {
            document.addEventListener('keydown', (e) => {

                
                // Press 'N' to open new request (when not in input)
                if (e.key === 'n' && e.ctrlKey && !['INPUT', 'TEXTAREA'].includes(document.activeElement.tagName)) {
                    e.preventDefault();
                    scrollToEventTypes();
                }
                
                // Press 'Escape' to close modals
                if (e.key === 'Escape') {
                    closeModal();
                    closeSuccessModal();
                }
                
                // Press 'S' to search/track
                if (e.key === 's' && e.ctrlKey) {
                    e.preventDefault();
                    showTrackSection();
                }
            });
        }

        // Performance Monitoring
        function initPerformanceMonitoring() {
            // Track page load time
            window.addEventListener('load', () => {
                const loadTime = performance.timing.loadEventEnd - performance.timing.navigationStart;
                console.log(`Page loaded in ${loadTime}ms`);
                
                if (loadTime > 3000) {
                    showToast('Page load time is slower than expected', 'warning');
                }
            });
            
            // Track scroll performance
            let scrollTimeout;
            window.addEventListener('scroll', () => {
                updateProgress((window.scrollY / (document.documentElement.scrollHeight - window.innerHeight)) * 100);
                
                clearTimeout(scrollTimeout);
                scrollTimeout = setTimeout(() => {
                    updateProgress(0);
                }, 1000);
            });
        }

        // Quick Tour Function
        function showQuickTour() {
            showToast('Welcome to Samskriti Audio System! This tour will guide you through the features.', 'info', 5000);
            
            // Simple tour steps
            setTimeout(() => {
                showToast('Step 1: Choose your event type from the cards below', 'info', 3000);
                document.querySelector('.event-types').scrollIntoView({ behavior: 'smooth' });
            }, 1000);
            
            setTimeout(() => {
                showToast('Step 2: Fill in your event details', 'info', 3000);
            }, 4000);
            
            setTimeout(() => {
                showToast('Step 3: Track your request status anytime', 'info', 3000);
            }, 7000);
        }

        // Advanced Error Handling
        function handleApiError(error, context = '') {
            console.error(`API Error in ${context}:`, error);
            
            let message = 'An unexpected error occurred';
            
            if (error.message) {
                if (error.message.includes('fetch')) {
                    message = 'Network error. Please check your connection.';
                } else if (error.message.includes('timeout')) {
                    message = 'Request timed out. Please try again.';
                } else {
                    message = error.message;
                }
            }
            
            showToast(message, 'error');
            hideLoading();
        }

        // Enhanced Submit Request
        async function submitRequestEnhanced() {
            const hours = parseInt(document.getElementById('durationHours').value) || 0;
            const minutes = parseInt(document.getElementById('durationMinutes').value) || 0;
            const totalDuration = hours + (minutes / 60);
            
            const formData = {
                eventType: currentEventType,
                name: document.getElementById('requestName').value,
                email: document.getElementById('requestEmail').value,
                eventDate: document.getElementById('requestDate').value,
                eventTime: document.getElementById('requestTime').value,
                eventDuration: totalDuration.toString(),
                venue: document.getElementById('requestVenue').value,
                numMics: document.getElementById('numMics').value,
                notes: document.getElementById('requestNotes').value
            };

            // Advanced validation
            const errors = validateForm(formData);
            if (errors.length > 0) {
                errors.forEach(error => showToast(error, 'error'));
                return;
            }

            showLoading();
            
            try {
                updateProgress(25);
                
                // Generate request ID and save to Firestore
                const timestamp = new Date().getTime();
                const requestId = `REQ${timestamp}`;
                
                const docData = {
                    requestId: requestId,
                    eventType: formData.eventType,
                    name: formData.name,
                    email: formData.email,
                    eventDate: formData.eventDate,
                    eventTime: formData.eventTime,
                    eventDuration: formData.eventDuration,
                    venue: formData.venue,
                    numMics: formData.numMics,
                    notes: formData.notes,
                    status: "Raised and Sent to Schedule Team",
                    createdAt: firebase.firestore.FieldValue.serverTimestamp()
                };
                
                await db.collection('audioRequests').add(docData);
                
                updateProgress(100);
                showToast('Request submitted successfully!', 'success');
                document.getElementById('requestIdDisplay').textContent = `Request ID: ${requestId}`;
                closeModal();
                setTimeout(() => {
                    document.getElementById('successModal').classList.add('active');
                }, 500);
            } catch (error) {
                handleApiError(error, 'submitRequest');
            } finally {
                setTimeout(() => {
                    hideLoading();
                    updateProgress(0);
                }, 1000);
            }
        }

        // Initialize everything when DOM is ready
        document.addEventListener('DOMContentLoaded', () => {
            initParticles();
            initScrollReveal();
            initKeyboardShortcuts();
            initPerformanceMonitoring();
            
            // Show welcome message
            setTimeout(() => {
                showToast('Welcome to Samskriti Audio Management System! Press Ctrl+T for theme toggle', 'info', 4000);
            }, 1000);
            
            
            // Initialize date picker with enhanced options
            if (typeof flatpickr !== 'undefined') {
                flatpickr("#requestDate", {
                    minDate: "today",
                    maxDate: new Date().fp_incr(90), // 90 days from now
                    disable: [
                        function(date) {
                            // Disable weekends (optional)
                            return (date.getDay() === 0 || date.getDay() === 6);
                        }
                    ],
                    locale: {
                        firstDayOfWeek: 1
                    }
                });
            }
        });

        // Replace the old submitRequest with enhanced version
        window.submitRequest = submitRequestEnhanced;
    </script>
</body>
</html>