; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Isha game"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://assets/character.glb"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

textures/vram_compression/import_etc2_astc=true
textures/default_filters/anisotropic_filtering_level=16
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/use_taa=true
anti_aliasing/quality/use_debanding=true
anti_aliasing/screen_space_roughness_limiter/enabled=true
anti_aliasing/screen_space_roughness_limiter/amount=0.45
anti_aliasing/screen_space_roughness_limiter/limit=0.25
