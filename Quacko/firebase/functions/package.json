{
  "name": "@quacko/functions",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsc -w",
    "build": "esbuild src/index.ts --bundle --platform=node --format=cjs --outfile=lib/index.js --external:firebase --external:firebase-admin --external:@firebase/* --external:firebase-functions",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@quacko/ai": "*",
    "@quacko/backend": "*",
    "@quacko/domain": "*",
    "@quacko/types": "*",
    "@quacko/validation": "*",
    "firebase-admin": "^13.0.1",
    "firebase-functions": "^6.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "^0.24.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
