# Quacko mobile environment. Copy to `.env` and adjust.
# All values are EXPO_PUBLIC_* so they are inlined at build time.

# 1 = in-process demo backend (InMemoryStore + deterministic demo coach, no server, no login).
# 0 = real backend via the self-hosted server (apps/server). Requires EXPO_PUBLIC_API_URL.
EXPO_PUBLIC_DEMO_MODE=1

# Self-hosted backend origin, no trailing slash.
#  - Web: can stay empty → the app talks to the same origin (server serves both API + site).
#  - Native: must be the server URL, e.g. https://quacko.college.edu
EXPO_PUBLIC_API_URL=

# Server-side only: the server uses this to talk to an LLM (optional).
# When unset the server runs the deterministic demo coach for free.
#   AI_BASE_URL= (server env)   AI_API_KEY= (server env)   AI_MODEL=gpt-4o-mini