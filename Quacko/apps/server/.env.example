# Quacko server environment. Copy to `.env` or export in your shell.
# Used by apps/server (and by docker-compose.yaml).

# Where the SQLite DB + uploaded proof media live (created on demand).
DATA_DIR=.data

# Signing secret for auth JWTs. REQUIRED (>= 16 chars) in production —
# generate with: openssl rand -base64 32
JWT_SECRET=change-me-to-a-long-random-string

# Bind address / port for the web + API.
HOST=0.0.0.0
PORT=8787

# Timezone used to compute streaks and "today". IANA name, e.g. Asia/Kolkata.
TIMEZONE=Asia/Kolkata

# Optional absolute base URL (used for upload links when behind a proxy),
# e.g. https://quacko.college.edu
PUBLIC_URL=

# Directory holding the exported Expo web app, served at /. Optional.
WEB_DIR=

# Optional LLM coach. When AI_API_KEY is unset the server uses an offline,
# deterministic demo coach at zero cost.
#AI_API_KEY=
#AI_BASE_URL=https://api.openai.com/v1
#AI_MODEL=gpt-4o-mini

# Upload cap for proof media (default 20 MB).
MAX_UPLOAD_BYTES=20971520

# ---- used by docker-compose.yaml -------------------------------------------
# Enable an HTTPS front-end through Caddy: DOMAIN=quacko.college.edu
#DOMAIN=
#Public port mapping when running without TLS on a non-default port
#PORT=8787