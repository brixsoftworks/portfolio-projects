# NOTE: Create a .env file from this .env.example before running the app.
# Root .env — consumed by docker-compose.yaml and scripts/deploy-college.sh.
# Copy to `.env` in the repo root before deploying.

# REQUIRED — auth JWT signing secret (>= 16 chars). Generate:
#   openssl rand -base64 32
JWT_SECRET=change-me-to-a-long-random-string

# Public origin of the site, e.g. https://quacko.college.edu
PUBLIC_URL=

# Host port to expose when running WITHOUT the TLS profile.
PORT=8787

# IANA timezone used for streaks / "today".
TIMEZONE=UTC

# Optional LLM coach (else a deterministic offline coach is used for free).
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=gpt-4o-mini

# Enable automatic HTTPS through Caddy: Dockerfile-compose `--profile tls`.
# Must already resolve to this server.
DOMAIN=