{
  "name": "quacko",
  "version": "0.1.0",
  "private": true,
  "description": "Quacko - Don't Break the Streak. A social self-improvement game.",
  "workspaces": [
    "apps/*",
    "packages/*",
    "firebase/functions"
  ],
  "scripts": {
    "mobile": "npm run start --workspace=@quacko/mobile",
    "mobile:ios": "npm run ios --workspace=@quacko/mobile",
    "mobile:android": "npm run android --workspace=@quacko/mobile",
    "mobile:web": "npm run web --workspace=@quacko/mobile",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "e2e:build": "npm run e2e:export --workspace=@quacko/mobile",
    "e2e": "npm run e2e:build && playwright test -c e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  },
  "trustedDependencies": [
    "better-sqlite3",
    "esbuild"
  ],
  "allowScripts": {
    "@firebase/util@1.12.1": true,
    "esbuild@0.24.2": true,
    "esbuild@0.21.5": true,
    "protobufjs@7.6.6": true,
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.2": true
  }
}
