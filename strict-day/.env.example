# ============================================================================
# Strict Day - environment configuration
#
# The Android app does NOT embed secrets. This file documents the values the
# app and the Supabase edge functions consume, and which secrets live where.
#
# For the app:
#   SUPABASE_URL and SUPABASE_ANON_KEY are BuildConfig fields in
#   app/build.gradle.kts (SUPABASE_SYNC_ENABLED gates the whole layer). The
#   anon key is not a secret and is safe to ship; the service role key is NOT.
#
# For Supabase edge functions / project:
#   SERVICE_ROLE_KEY and provider webhook secrets are server-side secrets and
#   must be set in the Supabase project secrets, never in the app or this
#   file once you actually deploy.
# ============================================================================

# --- Android app (runtime config) -----------------------------------------
# Project URL from: Supabase Dashboard -> Settings -> API
SUPABASE_URL=https://your-project.supabase.co
# Public anon key (safe to ship in the app).
SUPABASE_ANON_KEY=your-anon-key

# --- Server-only secrets (Supabase project secrets, NOT the app) ----------
# Full-access service role key. Never ship in the client APK.
SERVICE_ROLE_KEY=your-service-role-key

# Provider webhook / OAuth secrets used by edge functions that bridge to
# external services. Only required when those functions are deployed.
GITHUB_WEBHOOK_SECRET=
NOTION_INTEGRATION_SECRET=
GOOGLE_DOCS_CLIENT_SECRET=
FITNESS_CLIENT_SECRET=

# --- Local device / build docs --------------------------------------------
# sdk.dir=/path/to/Android/Sdk   (in local.properties, never committed)