# Strict Day - Supabase edge function secrets
#
# Used with `supabase functions serve --env-file supabase/.env` and set as
# project secrets after deployment (`supabase secrets set`). Never ship these
# in the Android app.
#
# SUPABASE_URL / SUPABASE_ANON_KEY are injected automatically when functions
# are deployed to the hosted platform; include them here for local serving.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-local-anon-key
SERVICE_ROLE_KEY=your-local-service-role-key

# Provider webhook secrets (required only by functions that verify external events).
GITHUB_WEBHOOK_SECRET=
NOTION_INTEGRATION_SECRET=
GOOGLE_DOCS_CLIENT_SECRET=
FITNESS_CLIENT_SECRET=