#VRML_SIM R2025a utf8

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackground.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackgroundLight.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/floors/protos/Floor.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/appearances/protos/SandyGround.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/factory/containers/protos/CardboardBox.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/factory/containers/protos/WoodenBox.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/humans/pedestrian/protos/Pedestrian.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/robots/dji/mavic/protos/Mavic2Pro.proto"

WorldInfo {
  info [
    "Autonomous AI Drone 3D Arena with DJI Matrice ML Engine"
  ]
  title "Mini AI Drone 3D Simulation"
  basicTimeStep 16
  defaultDamping Damping {
    linear 0.5
    angular 0.5
  }
}

Viewpoint {
  orientation -0.04 0.15 0.98 2.85
  position 3.8 -2.4 2.2
  near 0.1
  follow "Mavic 2 PRO"
  followSmoothness 0.2
}

TexturedBackground {
  luminosity 2.5
}

TexturedBackgroundLight {
}

Floor {
  size 60 60
  tileSize 2 2
  appearance SandyGround {
  }
}

# Chief Pilot Target for ActiveTrack & Face Recognition
Pedestrian {
  translation 0 3.2 1.27
  rotation 0 0 1 3.14159
  name "target_pilot"
  controller "<none>"
}

# Obstacles in flight corridor
CardboardBox {
  translation 1.6 1.8 0.3
  name "cardboard box 1"
}

WoodenBox {
  translation -1.4 2.2 0.3
  name "wooden box 1"
}

CardboardBox {
  translation -0.6 4.5 0.4
  name "cardboard box 2"
}

# The Drone Prototype
Mavic2Pro {
  translation 0 0 0.15
  rotation 0 0 1 1.5708
  name "Mavic 2 PRO"
  controller "<extern>"
  cameraSlot [
    Camera {
      name "camera"
      width 640
      height 480
      fieldOfView 1.05
    }
  ]
}
