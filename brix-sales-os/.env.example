# Brix Sales OS — Environment Configuration Template

# Operational Mode: SIMULATION, ASSISTED_PRODUCTION, or CONTROLLED_AUTOMATION
OPERATING_MODE=ASSISTED_PRODUCTION

# Debug logging
DEBUG=false

# Global Emergency Kill-Switch (true halts all outbound dispatch)
EMERGENCY_STOP=false

# Sender Identification (CAN-SPAM / GDPR requirement)
SENDER_NAME="Mullai Nathan"
SENDER_TITLE="Senior Automation & AI Architect"
SENDER_EMAIL="mullai@brixsoftworks.com"

# Local AI Inference (Ollama running on RTX 5060 GPU)
OLLAMA_BASE_URL=http://localhost:11434
PRIMARY_MODEL=qwen2.5-coder:7b
FALLBACK_MODEL=llama3.2:3b
EMBEDDING_MODEL=nomic-embed-text:latest

# Database Connection (SQLite by default, or PostgreSQL)
DATABASE_URL=sqlite:///./data/brix_sales.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/brix_sales

# Outreach Limits & Safety
MAX_DAILY_OUTREACH=50
REQUIRE_EMAIL_APPROVAL=true
REQUIRE_PROPOSAL_APPROVAL=true

# External Service Endpoints (Optional integrations)
AGENTSDR_URL=http://localhost:3000
AGENCY_PORTAL_URL=http://localhost:3850/sales
STRIPE_WEBHOOK_SECRET=
CALENDLY_API_KEY=
TWENTY_CRM_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
